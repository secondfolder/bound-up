# Local development configuration. `npm run dev` needs NOTHING from Cloudflare —
# it runs against a plain SQLite file via libsql, and reads these from .env.
#
#   cp .env.example .env
#
# Everything else the server needs — its auth secret, push keys, email, and the
# Daydreams providers — is a server setting, kept in the database and set from
# Settings → Admin → Server settings (docs/server-settings.md). The secrets are
# generated on first start; under `vite dev`, email goes to ./.mail-outbox
# until you set something else.

# The local dev database. Also used by drizzle-kit (generate/migrate/studio).
DATABASE_URL="file:./local.db"

# Sets the Cloudflare tunnel to use for `npm run dev`.
CF_TUNNEL_NAME=""
# If true the Cloudflare will be used automatically when runnning `npm run dev`.
CF_TUNNEL_AUTO_START=""
