# Local development configuration. `npm run dev` needs NOTHING from Cloudflare —
# it runs against a plain SQLite file via libsql, and reads these from .env.
#
#   npm run secrets -- dev   # creates .env from this file and fills the secrets

# The local dev database. Also used by drizzle-kit (generate/migrate/studio).
DATABASE_URL="file:./local.db"

# Signing/encryption key for Better Auth sessions. Filled by
# `npm run secrets -- dev`. Better Auth silently falls back to a hard-coded
# default outside NODE_ENV=production, so hooks.server.ts throws if this is
# unset. In production it is a wrangler secret (`npm run secrets -- production`).
BETTER_AUTH_SECRET=""

# Web Push (notifications). Optional: without all three, the notifications
# settings say they are not set up here and nothing is sent. Filled by
# `npm run secrets -- dev`, which never replaces a pair that is already set.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Email (docs/email.md). Required: the server will not start without MAIL_FROM
# and exactly one transport. `npm run secrets -- dev` points it at a local
# outbox, where each email is written as a JSON file instead of being sent —
# open the newest one to find your sign-up link. To send for real, set
# RESEND_API_KEY or SMTP_URL instead and remove MAIL_OUTBOX_DIR.
MAIL_FROM=""
MAIL_OUTBOX_DIR=""
RESEND_API_KEY=""
SMTP_URL=""

# Daydreams (docs/daydreams.md). Optional: without a key the feature is off on
# this server. Each reply is a paid call to OpenRouter, so it is never filled
# in for you; `npm run secrets -- dev --openrouter-key sk-or-…` sets it.
# DAYDREAM_MODEL defaults to a model whose terms allow adult fiction.
OPENROUTER_API_KEY=""
DAYDREAM_MODEL=""

# Daydreams' pictures (docs/daydreams.md, "Pictures"). Optional: without a key
# there are none. Each is a paid call to Runware, so it is never filled in for
# you; `npm run secrets -- dev --runware-key …` sets it. The models default to
# ones tuned for adult imagery: a Z-Image Turbo fine-tune for photos, and an
# Illustrious (SDXL) checkpoint for illustrations. Either may be any Runware AIR
# of a Z-Image Turbo or SDXL-family model.
RUNWARE_AI_API_KEY=""
RUNWARE_AI_IMAGE_MODEL=""
RUNWARE_AI_IMAGE_MODEL_ILLUSTRATED=""

# Sets the Cloudflare tunnel to use for `npm run dev`.
CF_TUNNEL_NAME=""
# If true the Cloudflare will be used automatically when runnning `npm run dev`.
CF_TUNNEL_AUTO_START=""