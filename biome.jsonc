{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			// Generated by drizzle-kit; never hand-edited.
			"!drizzle",
			// Seed prose — keep one entry per line rather than reflowed.
			"!src/lib/server/db/seed-data.ts",
			// Vendored agent skills, pinned by skills-lock.json — not ours to reformat.
			"!.agents",
			"!skills-lock.json",
			// Frozen historical plans: formatting would silently rewrite frozen records.
			"!docs/historical-plans",
			// Served verbatim: favicons and the web manifest are assets, not source.
			"!static"
		]
	},
	// A rule Biome has no built-in for: see the file for what it checks.
	"plugins": ["./biome-plugins/navigation-through-resolve.grit"],
	"formatter": {
		"enabled": true,
		// Indentation, line endings and the final newline come from .editorconfig.
		"useEditorconfig": true,
		// Repeated from .editorconfig's max_line_length, which Biome 2.5 does not
		// read: it honours indent_style from there but still wraps at 80 columns.
		"lineWidth": 100
	},
	"javascript": {
		"formatter": { "quoteStyle": "single", "trailingCommas": "none" }
	},
	"css": { "formatter": { "quoteStyle": "single" } },
	"html": {
		// Needed to lint Svelte templates (a11y, each-block keys, unused
		// variables that are only read from markup) rather than only <script>.
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"indentScriptAndStyle": true,
			"whitespaceSensitivity": "strict",
			"selfCloseVoidElements": "always"
		}
	},
	"assist": {
		"actions": { "source": { "organizeImports": "on", "useSortedKeys": "off" } }
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "all",
			"types": "all",
			"test": "all",
			"svelte": "all",
			"drizzle": "all",
			"playwright": "all",
			// Frameworks this app does not use. `preset: "all"` would otherwise
			// apply, say, Qwik's lexical-scope rule to every closure.
			"qwik": "none",
			"react": "none",
			"reactNative": "none",
			"solid": "none",
			"next": "none",
			"vue": "none",
			"astro": "none",
			"tailwind": "none"
		},
		// Every rule in every group is on, at error severity — including the
		// ones Biome ships as infos, which would otherwise never fail `npm run
		// lint`. The exceptions are in the first override below, because a group
		// set to a severity cannot also list rules. Each exception says why;
		// anything not listed is enforced, so fix the code rather than growing
		// that list.
		"rules": {
			"preset": "all",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"overrides": [
		{
			// The exceptions to "every rule, as an error". See the note on
			// `linter.rules` above.
			"includes": ["**"],
			"linter": {
				"rules": {
					"correctness": {
						// Cannot see SvelteKit's `$lib`/`$app` aliases or the generated
						// `./$types`, and misreads re-exports such as `@sveltejs/kit`'s
						// `error`. svelte-check already fails on a genuinely missing import.
						"noUnresolvedImports": "off",
						// Vite and TypeScript's `bundler` resolution take extensionless
						// specifiers, which is the SvelteKit convention throughout.
						"useImportExtensions": "off"
					},
					"complexity": {
						// `void promise` is how a deliberately unawaited promise is marked,
						// which is what `noFloatingPromises` asks for. The two contradict.
						"noVoid": "off",
						// Arbitrary size limits. A Svelte component or a spec file is long
						// because the thing it describes is; splitting to satisfy a count
						// scatters the explanation that sits next to the code.
						"noExcessiveLinesPerFunction": "off",
						"noExcessiveCognitiveComplexity": "off",
						// The crypto and halftone primitives take positional arguments that
						// mirror the maths or the spec they implement.
						"useMaxParams": "off"
					},
					"performance": {
						// Sequential awaits in this codebase are deliberate: keystrokes in
						// order, one IndexedDB write at a time, retries.
						"noAwaitInLoops": "off"
					},
					"security": {
						// An entropy heuristic that fires on CSS selectors and URLs. Real
						// secret scanning belongs in the git host, not the linter.
						"noSecrets": "off"
					},
					"style": {
						// Would outlaw `a ? b : c` everywhere, including Svelte markup where
						// an expression is the only thing allowed.
						"noTernary": "off",
						// Would turn every `0.5`, `1000` and `32` into a named constant.
						"noMagicNumbers": "off",
						// Same reasoning as noExcessiveLinesPerFunction above.
						"noExcessiveLinesPerFile": "off",
						// An early `continue` is the loop form of the guard clauses this
						// codebase prefers everywhere else.
						"noContinue": "off",
						// Hex colours appear only as fallbacks inside `var(--wa-*, #…)`.
						"noHexColors": "off",
						// Types live next to the code that uses them, which puts some
						// exports before local helpers. Reordering buries that context.
						"useExportsLast": "off",
						"useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								// Svelte components are PascalCase by convention; everything
								// else is kebab-case, with a few older camelCase schema files.
								"filenameCases": ["kebab-case", "camelCase", "PascalCase"]
							}
						},
						"useNamingConvention": {
							"level": "error",
							"options": {
								// `rpID`, `baseURL`, `createDOM`, `toJSON` are other libraries'
								// names, not ours to change.
								"strictCase": false,
								"conventions": [
									{
										// Wire formats and bindings we do not own: oEmbed's
										// `provider_name`, Cloudflare's `BETTER_AUTH_SECRET`,
										// Svelte's `a11y_*` warning codes.
										"selector": { "kind": "objectLiteralProperty" },
										// One leading underscore is another library's "internal"
										// marker, like superforms' `_errors`; the rest is checked.
										"match": "_?(.+)",
										"formats": ["camelCase", "PascalCase", "snake_case", "CONSTANT_CASE"]
									},
									{
										"selector": { "kind": "typeProperty" },
										// One leading underscore is another library's "internal"
										// marker, like superforms' `_errors`; the rest is checked.
										"match": "_?(.+)",
										"formats": ["camelCase", "PascalCase", "snake_case", "CONSTANT_CASE"]
									}
								]
							}
						}
					},
					"nursery": {
						// Nursery is on as a group so new rules arrive switched on. These
						// are the ones that are stylistic or wrong for this stack:
						// TypeScript's inference is the house style, and svelte-check
						// already rejects anything it cannot type.
						"useExplicitType": "off",
						"useExplicitReturnType": "off",
						// Function declarations and arrow constants are both idiomatic
						// here: declarations for named helpers, arrows for callbacks.
						"useConsistentFunctionStyle": "off",
						// Svelte scopes every <style> block to its component already.
						"useLayeredStyles": "off",
						// Dynamic values reach CSS through `style="--x: …"` custom
						// properties, which is the only way to do it in Svelte.
						"noInlineStyles": "off",
						// Adding `u` changes what an escape means (`\-` becomes a syntax
						// error) and buys nothing for patterns that never meet astral
						// characters.
						"useUnicodeRegex": "off",
						// ~190 sites, nearly all casts at a boundary TypeScript cannot
						// see through: JSON.parse, the DOM, a test double. Worth
						// revisiting a directory at a time rather than all at once.
						"noUnsafeTypeAssertion": "off",
						// Web Awesome and the halftone overlay rely on properties
						// (display: contents, user-select, line-clamp) that every
						// browser this app supports has, whatever their Baseline tag.
						"useBaseline": "off",
						// Suggests nano-staged over lint-staged; the pre-commit hook's
						// `vitest related` step is configured for lint-staged.
						"noRestrictedDependencies": "off",
						// Asks for `0 | 1 | 2` where a function is declared to return
						// `number`, and a subset of a union where it returns the domain
						// type on purpose. It is also the rule whose type inference
						// overflows its stack on superforms' `Infer<>`.
						"noMisleadingReturnType": "off",
						// A React rule; the nursery group being on bypasses the domain.
						"useReactFunctionComponentDefinition": "off",
						// Cannot see across Svelte's scoping: classes set through
						// `class:`, passed to child components, styled by Web Awesome's
						// stylesheet or matched under `:global()` all read as unused or
						// undeclared, and `--wa-*` properties come from a stylesheet
						// imported at runtime.
						"noUnusedClasses": "off",
						"noUndeclaredClasses": "off",
						"noUndeclaredCustomProperties": "off",
						// Mistakes every `regex.test(string)` for a test declaration.
						"useValidTestTitle": "off",
						// Lexical calls these on the node, so an override that happens
						// not to read `this` is still a method, not a free function.
						"useThisInClassMethods": {
							"level": "error",
							"options": { "ignoreOverrideMethods": true }
						},
						"useConsistentTestIt": {
							"level": "error",
							"options": { "function": "test", "withinDescribe": "it" }
						}
					},
					"suspicious": {
						// Lexical stores text formatting as a bitmask; `&`, `|` and `~` are
						// how it is read and written.
						"noBitwiseOperators": "off",
						"noConsole": { "level": "error", "options": { "allow": ["error", "warn", "info"] } }
					}
				}
			}
		},
		{
			// Biome's Svelte template formatter is not safe here yet (2.5.14): it
			// deletes some template comments, duplicates others on every run, and
			// re-flows whitespace-sensitive inline markup. svelte-check and review
			// cover these files until it can be switched back on.
			"includes": ["**/*.svelte"],
			"formatter": { "enabled": false },
			"linter": {
				"rules": {
					// Blind to names bound by `{#await p then value}`, and the Svelte
					// compiler (through svelte-check) already refuses any name that
					// is really undeclared.
					"correctness": { "noUndeclaredVariables": "off" }
				}
			}
		},
		{
			// Code that runs in Node rather than the browser or the Worker.
			"includes": [
				"*.config.ts",
				"*.config.js",
				"vitest-setup-browser.ts",
				"e2e/**",
				"scripts/**",
				"src/lib/server/db/**",
				// The attachment store `npm run dev` writes to disk; dead code in
				// the worker bundle.
				"src/lib/server/media/local.ts",
				"src/lib/testing/**",
				"**/*.test.ts"
			],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" },
					"style": { "noProcessEnv": "off" }
				}
			}
		},
		{
			// Ambient declarations only merge through the forms TypeScript
			// reserves for it: SvelteKit's `App` namespace takes `interface`s,
			// and a global is declared with `var` inside `declare global`.
			"includes": ["src/app.d.ts"],
			"linter": {
				"rules": {
					"style": { "useConsistentTypeDefinitions": "off", "noNamespace": "off" },
					"nursery": { "useVarsOnTop": "off" }
				}
			}
		},
		{
			// Tool configs are loaded by their tool, which requires a default export.
			"includes": ["*.config.ts", "*.config.js"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		},
		{
			// A regex literal in a test runs once per test; hoisting every
			// `{ name: /Save/ }` away from its assertion only hurts reading it.
			"includes": ["e2e/**", "**/*.test.ts", "src/lib/testing/**"],
			"linter": { "rules": { "performance": { "useTopLevelRegex": "off" } } }
		},
		{
			// Playwright has no `it`.
			"includes": ["e2e/**"],
			"linter": {
				"rules": {
					"nursery": {
						"useConsistentTestIt": {
							"level": "error",
							"options": { "function": "test", "withinDescribe": "test" }
						}
					}
				}
			}
		}
	]
}
