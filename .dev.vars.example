# Variables for the locally emulated Cloudflare Worker — used ONLY by
# `npm run preview` (wrangler dev reads .dev.vars, not .env).
# Everyday `npm run dev` does not need this file.
#
# The server's secrets, email and providers are not set here: they are server
# settings, in the D1 database, set from Settings → Admin → Server settings
# (docs/server-settings.md). Only Resend can send email on Workers.

# Sets the Cloudflare tunnel to use for `npm run preview`.
CF_TUNNEL_NAME=""
# If true the Cloudflare will be used automatically when runnning `npm run preview`.
CF_TUNNEL_AUTO_START=""
