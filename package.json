{
	"name": "bound-up",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && npm run db:migrate:preview && scripts/wrangler-with-defaults.sh dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome check --write . && node scripts/format-svelte.mjs",
		"lint": "biome ci --error-on-warnings . && node scripts/format-svelte.mjs --check",
		"test:unit": "vitest",
		"test": "vitest run && playwright test",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "drizzle-kit migrate",
		"db:migrate:preview": "wrangler d1 migrations apply DB --local",
		"db:migrate:production": "wrangler d1 migrations apply DB --remote",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:reset": "rm -f local.db local.db-shm local.db-wal && rm -rf local-media && npm run db:migrate && npm run db:seed",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config ./better-auth.config.ts --output src/lib/server/db/schema/auth.ts --yes",
		"auth:secret": "better-auth secret",
		"cf-typegen": "wrangler types ./src/worker-env.d.ts --include-runtime=false"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte,css,html,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"*.svelte": [
			"node scripts/format-svelte.mjs"
		]
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "2.5.14",
		"@cloudflare/workers-types": "^5.20260906.1",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.4.1",
		"@vitest/browser-playwright": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"playwright": "^1.63.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"sveltekit-cloudflare-do": "^0.2.1",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@awesome.me/webawesome": "^3.12.0",
		"@better-auth/passkey": "1.7.5",
		"@cloudflare/vite-plugin": "^1.56.0",
		"@floating-ui/dom": "^1.8.0",
		"@js-temporal/polyfill": "^0.5.1",
		"@lexical/history": "^0.51.0",
		"@lexical/link": "^0.51.0",
		"@lexical/list": "^0.51.0",
		"@lexical/markdown": "^0.51.0",
		"@lexical/rich-text": "^0.51.0",
		"@lexical/selection": "^0.51.0",
		"@lexical/utils": "^0.51.0",
		"@scure/base": "^2.4.0",
		"@simplewebauthn/browser": "13.3.0",
		"@zumer/snapdom": "^3.1.1",
		"age-encryption": "0.3.1",
		"better-auth": "1.7.5",
		"countries-and-timezones": "^3.10.0",
		"drizzle-orm": "^0.45.2",
		"idb": "^8.0.3",
		"lexical": "^0.51.0",
		"linkifyjs": "^4.3.3",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.5.4"
	},
	"overrides": {
		"sveltekit-cloudflare-do": {
			"sveltekit-cloudflare-do": "$sveltekit-cloudflare-do"
		}
	},
	"engines": {
		"node": ">=20"
	}
}
