# The single source of truth for whitespace. Biome reads this file
# (`formatter.useEditorconfig` in biome.jsonc), so editors and the formatter
# cannot disagree about indentation or line length.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 100

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
